should match snapshot:
  1: |
    apiVersion: k8s.keycloak.org/v2beta1
    kind: Keycloak
    metadata:
      labels:
        app.kubernetes.io/component: keycloak
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: 26.7.2
        helm.sh/chart: keycloak-operator-1.13.0
      name: keycloak
    spec:
      features:
        disabled:
          - kerberos
        enabled:
          - account
          - admin
          - web-authn
      hostname:
        backchannelDynamic: false
        hostname: keycloak.example.com
        strict: true
      http:
        httpEnabled: true
      ingress:
        annotations:
          test: value
        enabled: true
      instances: 1
      serviceMonitor:
        annotations: {}
        enabled: true
        interval: 30s
        labels: {}
        scrapeTimeout: 10s
      startOptimized: false
      transaction:
        xaEnabled: false
  2: |
    apiVersion: k8s.keycloak.org/v2alpha1
    kind: KeycloakOIDCClient
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: 26.7.2
        helm.sh/chart: keycloak-operator-1.13.0
      name: RELEASE-NAME-keycloak-operator-test
    spec:
      client:
        appUrl: https://example.org/app
      keycloakCRName: keycloak
      realm: test
  3: |
    apiVersion: k8s.keycloak.org/v2beta1
    kind: KeycloakRealmImport
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: 26.7.2
        helm.sh/chart: keycloak-operator-1.13.0
      name: RELEASE-NAME-keycloak-operator-test
    spec:
      keycloakCRName: keycloak
      realm:
        id: test
        realm: test
        users:
          - email: john.sausage@example.com
            firstName: Hans
            id: "0"
            lastName: Wurst
            username: john.sausage
  4: |
    apiVersion: k8s.keycloak.org/v2alpha1
    kind: KeycloakSAMLClient
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/version: 26.7.2
        helm.sh/chart: keycloak-operator-1.13.0
      name: RELEASE-NAME-keycloak-operator-test
    spec:
      client:
        appUrl: https://example.org/app
      keycloakCRName: keycloak
      realm: test
