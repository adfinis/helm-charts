    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/name: keycloak-operator
      name: keycloak-operator-clusterrole
    rules:
      - apiGroups:
          - config.openshift.io
        resources:
          - ingresses
        verbs:
          - get
  3: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/name: keycloak-operator
        app.kubernetes.io/version: 26.8.2
      name: keycloakrealmimportcontroller-cluster-role
    rules:
      - apiGroups:
          - k8s.keycloak.org
        resources:
          - keycloakrealmimports
          - keycloakrealmimports/status
          - keycloakrealmimports/finalizers
        verbs:
          - get
          - list
          - watch
          - patch
          - update
          - create
          - delete
      - apiGroups:
          - batch
        resources:
          - jobs
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - watch
      - apiGroups:
          - ""
        resources:
          - secrets
        verbs:
          - create
          - delete
          - get
          - list
          - patch
          - update
          - watch
